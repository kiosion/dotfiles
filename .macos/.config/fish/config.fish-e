#
# Configuration options for fish shell
set -gx AWS_DEFAULT_REGION "us-east-1"

# Setup user PATHs
fish_add_path /opt/homebrew/bin
fish_add_path /opt/homebrew/sbin
fish_add_path /usr/local/bin
fish_add_path $HOME/.local/bin

# Set SSH agent socket to yubikey-agent
# TODO: Finish config of ~/.ssh/config for per-host socket use
set -gx SSH_AUTH_SOCK "/opt/homebrew//var/run/yubikey-agent.sock"

# Teleport local dev helpers
set -gx TELEPORT_USE_LOCAL_SSH_AGENT false
set -gx TP_CONF "$HOME/Dev/teleport-local/conf"
set -gx TP_BIN "$HOME/Dev/teleport-local/bin/teleport"

# Setup gpg
if status --is-interactive
    set -gx GPG_TTY (tty)
end

# Init starship
set -gx STARSHIP_CONFIG $HOME/.config/starship/starship.toml
starship init fish | source

# Abbrs
abbr -a la "ls -lah"
abbr -a md "mkdir -p"
abbr -a gits "git status"
abbr -a gitc "git checkout"
abbr -a gitca "git commit --amend"
abbr -a gitcan "git commit --amend --no-edit"
abbr pf "pfetch"
abbr python3 "python"
abbr py "python"

if status --is-interactive
    # Init Zoxide (don't alias `cd` outside of interactive shells)
    zoxide init fish --cmd cd | source

    # B/c MacOS is ✨ special ✨ and doesn't allow disabling new shells' login message :)
    printf '\33c\e[3J'
end

