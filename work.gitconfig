[user]
	email = hi@kio.dev
	name = Maxim Dietz
        signingkey = 8A2C67E22184F162
[includeIf "hasconfig:remote.*.url:git@github.com:gravitational/**"]
	path = ~/dotfiles/gravitational.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/gravitational/**"]
	path = ~/dotfiles/gravitational.gitconfig
[commit]
	gpgsign = true
[core]
	editor = vim
	excludesfile = ~/.gitignore
        pager = delta
[interactive]
        diffFilter = delta --color-only
[delta]
        navigate = true
[merge]
        conflictStyle = zdiff3
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[push]
        autoSetupRemote = true
[generated]
        exclude = *.pb.go
        exclude = *.gen.go
        exclude = *_pb.ts
[alias]
        dx = "!f() { a=$(mktemp); trap 'rm -f \"$a\"' EXIT INT TERM; git config --get-all generated.exclude | sed 's/$/ -diff/' > \"$a\"; git -c core.attributesFile=\"$a\" diff \"$@\" | delta; }; f" 
